    "template:scaffold": "tsx scripts/scaffold-template.ts",
    "template:verify": "tsx scripts/verify-template.ts",
    "template:verify:ci": "tsx scripts/verify-templates-ci.ts",
    "performance:verify": "tsx scripts/verify-initial-assets.ts",
    "template:image": "tsx --env-file=.env.local scripts/host-image.ts",
