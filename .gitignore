# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent artifacts
.gemini/

# local scripts (migration helpers, one-off tooling — add to personal .git/info/exclude)
.claude/*
# …but project skills are version-controlled (shared dev-time tooling)
!.claude/skills/
# third-party skills (npx skills) land in .claude/skills/ as machine-specific
# absolute-path symlinks — ignore them. The real files live in .agents/ and are
# restorable via skills-lock.json (`npx skills experimental_install`). Keep only
# the in-repo project skills (new-template, delete-template) tracked.
.claude/skills/*
!.claude/skills/new-template/
!.claude/skills/delete-template/

# internal portfolio prep notes (interview cheatsheet — not for public)
docs/PORTFOLIO_ENTRY.md
